# ============================================================
# AI Interviewer — Environment Variables
# Copy this file to .env and fill in your values.
# Do NOT commit your .env file to version control.
# ============================================================

# ────────────────────────────────────────────────────────────
# Supabase (required)
# ────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ────────────────────────────────────────────────────────────
# n8n Webhook URLs (required)
#
# In production: use full URLs (https://your-n8n.com/webhook/...)
# In local dev:  use relative paths (/webhook/...) and configure
#                a Vite proxy to your n8n instance in vite.config.ts
# ────────────────────────────────────────────────────────────

# HR candidate intake — parses JD + resume via Groq, stores candidate data
VITE_WEBHOOK_CANDIDATE_INTAKE=/webhook/candidate-intake

# Session creation — creates interview session, generates 10 questions, sends invite email
VITE_WEBHOOK_SESSION_CREATION=/webhook/create-session

# Interview engine — handles answer analysis, turn generation, and targeted follow-up
# (dispatched via the `action` field: analyze-answer | generate-turn | targeted-followup)
VITE_WEBHOOK_INTERVIEW_ENGINE=/webhook/interview-engine

# Candidate analysis — fit analysis + resume truth audit + draft questions (HR panel)
VITE_WEBHOOK_ANALYZE_CANDIDATE=/webhook/analyze-candidate

# Post-interview scoring pipeline
VITE_WEBHOOK_SCORING_PIPELINE=/webhook/score-interview

# Resume truthfulness audit — called at interview start
VITE_WEBHOOK_AUDIT_RESUME_TRUTHFULNESS=/webhook/audit-resume-truthfulness

# Candidate fit analysis — used as interview fallback when no blueprint is cached
VITE_WEBHOOK_ANALYZE_CANDIDATE_FIT=/webhook/analyze-candidate-fit

# ────────────────────────────────────────────────────────────
# Deepgram API (Speech-to-Text)
#
# High-accuracy live transcription over WebSockets.
# Get a free key at https://console.deepgram.com
# If left blank, the app will fall back to browser Web Speech API.
# ────────────────────────────────────────────────────────────
VITE_DEEPGRAM_API_KEY=your-deepgram-api-key-here
VITE_DEEPGRAM_MODEL=nova-2
VITE_DEEPGRAM_TTS_MODEL=aura-orion-en

# ────────────────────────────────────────────────────────────
# Groq API (configured in n8n, not in the frontend directly)
#
# The VITE_GROQ_API_KEY is only needed if your n8n nodes read
# it from an environment variable rather than a stored credential.
# If using n8n credential storage, leave this blank.
# ────────────────────────────────────────────────────────────
# VITE_GROQ_API_KEY=gsk_your-groq-api-key
